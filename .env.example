# Dijital Kütüphane - Ortam Değişkenleri Şablonu
# Bu dosyayı '.env' olarak kopyalayıp değerleri doldurun:
# cp .env.example .env

# --- Sunucu Ayarları ---
PORT=8000
HOST=0.0.0.0
AUTO_OPEN_BROWSER=True

# --- Güvenlik (ÖNEMLİ!) ---
# Kütüphane giriş şifresi:
# DİKKAT: Docker veya uzak sunucu (0.0.0.0) kurulumlarında ACCESS_PASSWORD zorunludur!
# Boş bırakılırsa güvenlik nedeniyle yalnızca localhost erişebilir, dış ağ istekleri 403 ile engellenir.
ACCESS_PASSWORD=guclu_bir_sifre_belirleyin

# Yalnızca kütüphaneyi bilerek internete tamamen şifresiz açmak istiyorsanız True yapın (Önerilmez!):
ALLOW_UNPROTECTED_REMOTE_ACCESS=False

# Oturum çerez imzalama anahtarı (güçlü ve rastgele bir değer girin):
SESSION_SECRET=guclu_rastgele_session_gizli_anahtari_32_karakter

# API yönetici token'ı (opsiyonel header: X-Admin-Token):
ADMIN_TOKEN=

# HTTPS kullanıyorsanız 1 yapın:
COOKIE_SECURE=0

# --- Hız Sınırlama (Brute-Force Koruması) ---
LOGIN_WINDOW_SECONDS=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=600

# --- AI Yapılandırması (Opsiyonel) ---
# Gemini API anahtarı (Web arayüzündeki Ayarlar menüsünden de girilebilir):
GEMINI_API_KEY=
COHERE_API_KEY=

# --- Yükleme ve İşlem Limitleri ---
MAX_UPLOAD_MB=250
MAX_COVER_MB=8
MAX_IMAGE_PIXELS=25000000
MAX_CONCURRENT_TASKS=1
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Telegram Entegrasyonu (Opsiyonel) ---
# https://my.telegram.org adresinden alınabilir:
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Gelişmiş / DevOps ---
# Ters proxy (Nginx, Traefik, Cloudflare) arkasındaysanız True yapın:
TRUST_PROXY=False
# Log seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
